pipeline {
    agent any

    stages {
        stage('Tests') {
            agent {
                docker {
                    image 'ppodgorsek/robot-framework:latest'
                    args "--entrypoint='' --shm-size=2g"
                    reuseNode true
                }
            }

            steps {
                sh '''
                    python -m venv .venv

                    .venv/bin/pip install --upgrade pip
                    .venv/bin/pip install robotframework
                    .venv/bin/pip install robotframework-seleniumlibrary
                    .venv/bin/pip install robotframework-datadriver
                    .venv/bin/pip install allure-robotframework

                    .venv/bin/robot \
                        --listener allure_robotframework:allure-results \
                        ./tests/
                '''
            }
        }
    }

    post {
        always {
            allure([
                results: [[path: 'allure-results']]
            ])
        }
    }
}