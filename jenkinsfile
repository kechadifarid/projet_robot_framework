pipeline {
    agent any

    stages {
        stage('Tests') {
            steps {
                script {
                    docker.image('selenium/standalone-chrome:latest').withRun('--shm-size=2g') { chrome ->
                        docker.image('ppodgorsek/robot-framework:latest').inside("--entrypoint='' --link ${chrome.id}:chrome") {
                            sh '''
                                python -m venv .venv
                                .venv/bin/pip install --upgrade pip
                                .venv/bin/pip install robotframework robotframework-seleniumlibrary robotframework-datadriver allure-robotframework

                                .venv/bin/robot \
                                    --listener allure_robotframework:allure-results \
                                    --variable REMOTE_URL:http://chrome:4444/wd/hub \
                                    --variable BROWSER:chrome \
                                    ./tests/
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            allure([results: [[path: 'allure-results']]])
        }
    }
}